{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pakem:protocol:v1:capabilities",
  "title": "Pakem Protocol v1 Capabilities",
  "type": "object",
  "required": ["protocol", "version", "capabilities"],
  "properties": {
    "protocol": {"const": "pakem"},
    "version": {"const": "1.0"},
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
