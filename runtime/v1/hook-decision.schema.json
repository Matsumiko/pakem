{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pakem:runtime:v1:hook-decision",
  "title": "Pakem Lifecycle Hook Decision v1",
  "type": "object",
  "required": ["protocol", "runtime_version", "hook", "decision", "allowed", "requiresApproval", "reason", "category", "risk", "receipt"],
  "properties": {
    "protocol": {"const": "pakem"},
    "runtime_version": {"const": 1},
    "hook": {"enum": ["session.start", "task.before", "task.after", "verification.before", "session.finish", "handover"]},
    "decision": {"enum": ["allow", "require_approval", "deny"]},
    "allowed": {"type": "boolean"},
    "requiresApproval": {"type": "boolean"},
    "reason": {"type": "string"},
    "category": {"enum": ["read", "write", "command", "destructive", "deploy", "security", "policy_change", "gate_change"]},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "approvalId": {"type": "string"},
    "receipt": {
      "type": "object",
      "required": ["hook", "occurredAt", "decision", "category", "risk", "reason"],
      "properties": {
        "hook": {"type": "string"},
        "occurredAt": {"type": "string", "format": "date-time"},
        "decision": {"enum": ["allow", "require_approval", "deny"]},
        "category": {"type": "string"},
        "risk": {"type": "string"},
        "targetHash": {"type": ["string", "null"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
