{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pakem:runtime:v1:checkpoint",
  "title": "Pakem Runtime Checkpoint v1",
  "type": "object",
  "required": ["schemaVersion", "checkpointId", "workflowId", "label", "createdAt", "workflow", "repository"],
  "properties": {
    "schemaVersion": {"const": 1},
    "checkpointId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "label": {"type": "string"},
    "createdAt": {"type": "string", "format": "date-time"},
    "workflow": {"$ref": "urn:pakem:runtime:v1:workflow"},
    "repository": {"type": "object", "required": ["head", "status"], "properties": {"head": {"type": ["string", "null"]}, "status": {"type": ["array", "null"], "items": {"type": "string"}}, "additionalProperties": true}}
  },
  "additionalProperties": false
}
