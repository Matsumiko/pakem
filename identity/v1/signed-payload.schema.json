{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pakem:identity:v1:signed-payload",
  "title": "Pakem Ed25519 Signed Payload v1",
  "type": "object",
  "required": [
    "format",
    "algorithm",
    "agentId",
    "fingerprint",
    "payload",
    "payloadSha256",
    "signature"
  ],
  "properties": {
    "format": {
      "const": "pakem.signed-payload.v1"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "agentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {},
    "payloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "minLength": 80,
      "maxLength": 100
    }
  },
  "additionalProperties": false
}
