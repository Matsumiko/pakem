{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pakem:identity:v1:identity-registry",
  "title": "Pakem Agent Identity Registry v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "agents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "urn:pakem:identity:v1:agent-identity"
      }
    }
  },
  "additionalProperties": false
}
